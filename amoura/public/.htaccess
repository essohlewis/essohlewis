# Front controller : tout le trafic non-fichier est routé vers index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Sert directement les fichiers/dossiers existants (assets, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Sinon, tout passe par le contrôleur frontal.
    RewriteRule ^ index.php [L]
</IfModule>

# Empêche l'accès direct aux fichiers sensibles.
<FilesMatch "\.(env|sql|md|json|lock)$">
    Require all denied
</FilesMatch>

# Désactive l'exécution PHP dans le dossier des téléversements.
<Directory "uploads">
    php_flag engine off
</Directory>
