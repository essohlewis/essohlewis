# ── Application ───────────────────────────────────────────────
APP_NAME="Amoura"
APP_ENV=local            # local | production
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=                 # 32+ octets aléatoires — générer: php scripts/gen_key.php
APP_TIMEZONE=UTC

# ── Base de données ───────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=amoura
DB_USER=amoura
DB_PASS=secret
DB_CHARSET=utf8mb4

# ── WebSocket / Temps réel ────────────────────────────────────
WS_HOST=0.0.0.0
WS_PORT=8090
WS_PUBLIC_URL=ws://localhost:8090

# ── WebRTC (signaling + traversée NAT) ────────────────────────
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USER=
TURN_PASS=

# ── Mail (SMTP) ───────────────────────────────────────────────
MAIL_DRIVER=log          # log | smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="no-reply@amoura.example"
MAIL_FROM_NAME="Amoura"

# ── SMS (OTP / notifications) ─────────────────────────────────
SMS_DRIVER=log           # log | http
SMS_FROM="Amoura"        # sender id / expéditeur
SMS_HTTP_URL=            # endpoint REST du prestataire (POST JSON {from,to,message})
SMS_HTTP_TOKEN=          # clé API / bearer
SMS_HTTP_TIMEOUT=10

# ── File d'attente d'envoi (e-mail/SMS asynchrone) ────────────
QUEUE_DRIVER=sync        # sync (livraison immédiate) | async (via worker/cron)
QUEUE_BATCH=50           # messages traités par passe du worker
QUEUE_IDLE_SLEEP=5       # secondes d'attente du worker démon quand la file est vide

# ── Paiements (les clés « live » sont surchargeables via l'admin/CMS) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=   # « verif-hash » attendu sur le webhook Flutterwave

# ── Cache & passage à l'échelle ───────────────────────────────
CACHE_DRIVER=array       # array | redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
REDIS_PREFIX=amoura:
# Bus temps réel pour le clustering WebSocket multi-instance (redis|local)
REALTIME_BUS=local
REDIS_CHANNEL=amoura:realtime

# ── Réplica de lecture (optionnel — séparation lecture/écriture) ──
DB_READ_HOST=            # laisser vide pour utiliser le primaire
DB_READ_PORT=3306
DB_READ_USER=
DB_READ_PASS=

# ── Stockage des médias (local | s3) + CDN ────────────────────
STORAGE_DRIVER=local
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
CDN_URL=                 # ex. https://cdn.amoura.example (sinon URL S3/local)

# ── Sécurité ──────────────────────────────────────────────────
SESSION_LIFETIME=120     # minutes
RATE_LIMIT_LOGIN=5       # tentatives / minute

# ── Observabilité ─────────────────────────────────────────────
# Jeton d'accès à /metrics (exposition Prometheus). Vide = endpoint fermé.
METRICS_TOKEN=
